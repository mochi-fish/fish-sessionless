{
  "_comment": "Anthropic 臂的样板。caps 是美元，0 = 不许花。arm 为 real 时要 approvalsFile（格式见 approvals.example.json）。",
  "arm": "real",
  "approvalsFile": "approvals.example.json",
  "stateDir": "<run>/fwd-state",
  "certsDir": "<experiment>/cache/certs",
  "target": {
    "provider": "anthropic",
    "model": "claude-opus-5-5",
    "effort": "high",
    "maxTokens": 32000
  },
  "caps": {
    "anthropic": 0
  },
  "usageFeedback": "pinned",
  "summaryPolicy": "refuse",
  "transforms": {
    "stripNudge": true,
    "images": "placeholder",
    "stripForeignThinking": true,
    "localPaths": true
  },
  "plainHttp": {
    "requireToken": true
  }
}
